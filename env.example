# 🌟 Envimerse Environment Variables

# ===== CONFIGURAÇÃO BÁSICA =====
NEXT_PUBLIC_APP_URL=https://envimerse.com
NEXT_PUBLIC_APP_NAME=Envimerse

# ===== WEB3 (ESSENCIAL) =====
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key

# ===== PAGAMENTOS =====
# Stripe (Funcionando ✅)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Onramper (Muito caro - removido por enquanto ❌)
# NEXT_PUBLIC_ONRAMPER_API_KEY=onramper_test_key

# ===== ANALYTICS =====
# Google Analytics (Opcional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_google_analytics_id

# Mixpanel (Project Token ✅)
NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_project_token

# ===== FUTURO =====
# Database
DATABASE_URL=your_database_url

# IA Features
OPENAI_API_KEY=your_openai_key

# IPFS/NFTs
PINATA_API_KEY=your_pinata_key
PINATA_SECRET_KEY=your_pinata_secret 